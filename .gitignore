__pycache__/

python_env/
orpheus_env/

tmp/
models/

.DS_Store
*.wixobj

# Python build artifacts (e.g. num2words setup.py build output)
build/
*.egg-info/

# Runtime TTS session data (written under voices/ during conversion)
voices/__sessions/

# Runtime logs
logs/
conversion.log

# Gradio's serve cache — copies of every file passed through the web UI, plus its
# resampled derivatives. Regenerated on demand; never repo content.
/.cache/

# ebooks/ is the drop folder for input books, so anything left there after a run
# dirties the tree. The test fixtures under ebooks/tests/ stay tracked.
/ebooks/*
!/ebooks/.gitkeep
!/ebooks/tests/

# Benchmark harness output (bench_orpheus_mlx.py / bench_validate_real.py)
bench_*.log

# Unsloth compiled kernel cache (build artifact)
/unsloth_compiled_cache/

# Benchmark harnesses, corpora, and their throwaway venvs (bench scripts live
# untracked by convention — see bench_*.log above)
bench_*.py
bench_*.json
/.venv-*/
